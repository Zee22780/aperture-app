# Copy to .env.local and fill in values. Never commit .env.local (already gitignored).

# --- Database (Neon Postgres) ---
# The only variable needed to run the app locally.
DATABASE_URL=

# --- Auth (Auth.js / NextAuth) ---
# AUTH_SECRET signs the session cookie. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=
# Google Cloud console -> Google Auth Platform -> Clients -> Web application.
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Photo storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Vision/LLM (OpenAI) ---
OPENAI_API_KEY=

# --- Not used yet ---
# Magic-link sign-in (Resend) and Apple sign-in are both deferred. The
# database tables they need already exist, so adding either later is a
# config change, not a migration. Variables intentionally left out until
# then: RESEND_API_KEY, AUTH_EMAIL_FROM, AUTH_APPLE_ID, AUTH_APPLE_SECRET.
